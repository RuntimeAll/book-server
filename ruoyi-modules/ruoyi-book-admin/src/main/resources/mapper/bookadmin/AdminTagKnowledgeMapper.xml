<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  PRD-B-006 收尾增量 — biz_tag_knowledge 共现反推表读 SQL。
  namespace 独立 (org.dromara.bookadmin.mapper.AdminTagKnowledgeMapper)，
  避开 ruoyi-book/ namespace；表 biz_tag_knowledge 由 V9 ETL 灌库（23635 行）。
-->
<mapper namespace="org.dromara.bookadmin.mapper.AdminTagKnowledgeMapper">

    <!--
      按 knowledge_id 反推共现 tag top N。
      命中索引 idx_knowledge_count(knowledge_id, co_count DESC)。
      字段 alias use_count → coCount 保持驼峰（resultType 走 VO 自动映射）。
      同 co_count 用 tag_id ASC 兜底稳定排序，防分页或重复请求 order 抖动。
    -->
    <select id="selectTopByKnowledge"
            resultType="org.dromara.bookadmin.domain.vo.TagWithCoCountVo">
        SELECT
            tk.tag_id   AS tagId,
            ft.name     AS tagName,
            tk.co_count AS coCount
        FROM biz_tag_knowledge tk
        JOIN biz_free_tag ft ON ft.id = tk.tag_id
        WHERE tk.knowledge_id = #{knowledgeId}
        ORDER BY tk.co_count DESC, tk.tag_id ASC
        LIMIT #{topN}
    </select>

</mapper>
