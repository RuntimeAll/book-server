<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-ai</artifactId>

    <description>
        ruoyi-ai 通用 AI / LLM 底座模块（PRD-B-006 骨架；PRD-B-007 填 provider 实现）
        - 接口契约: IAiProvider / IAiTextGenerator / IAiVisionGenerator
        - POJO: AiRequest / AiResponse / Message / Tool / ToolCall / TokenUsage / ResponseFormat /
                AiCapability / AiModelAlias / AiHealthStatus
        - 观测: IAiCallLogger / AiCallLogEntry
        - 配置: AiProperties (ai.* 占位)
        - 跨 PRD 复用承诺: B-007/009/010 + C 线教师 agent (WF1-5) + A 线教研内容生成统一复用本模块
    </description>

    <dependencies>

        <!-- 通用工具（R / ServiceException / StringUtils 等） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- 校验 (@Valid / @NotBlank) — B-007 provider 实现入参校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- WebClient（B-007 调 lk888 / aigeekapi 用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- MyBatis-Plus（B-007 落 biz_ai_call_log 表用） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <!-- @ConfigurationProperties 注解处理器 (AiProperties 生成 metadata) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

</project>
