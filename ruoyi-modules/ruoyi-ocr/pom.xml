<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-ocr</artifactId>

    <description>
        ruoyi-ocr 通用 OCR 底座模块（PRD-B-006 骨架；PRD-B-007 填 TextinOcrProvider）
        - 接口契约: IOcrProvider
        - POJO: OcrRequest / OcrResult / OcrPage / OcrBlock / OcrCapability / OcrHealthStatus
        - 配置: OcrProperties (ocr.* 占位)
        - 跨 PRD 复用承诺: 题库 PDF / 卷库 PDF / 课件 PDF / 教研素材 OCR / 老师手写答题 OCR 等
          所有场景统一复用本模块，禁止业务模块内直接 new TextinClient()
    </description>

    <dependencies>

        <!-- 通用工具 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- 校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- WebClient（B-007 调 textin 用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- @ConfigurationProperties 注解处理器 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

</project>
