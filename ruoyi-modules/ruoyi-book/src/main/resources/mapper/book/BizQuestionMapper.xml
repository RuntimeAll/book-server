<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  题目主表 Mapper XML（biz_question）。

  关键映射点（misikt JSON 风格 ↔ DB 列名）：
    stem_img_url       → stemImg
    answer_img_url     → answerImg
    explain_img_url    → explainImg
    file_bin_url       → fileBin
    create_time / update_time DATETIME → createTime / updateTime BIGINT ms timestamp
      —— UNIX_TIMESTAMP(t)*1000 直接出 long
-->
<mapper namespace="org.dromara.book.mapper.BizQuestionMapper">

    <!-- 列表项 ResultMap（page 用，无详情字段） -->
    <resultMap id="QuestionItemMap" type="org.dromara.book.domain.vo.QuestionItemVo">
        <id property="id" column="id"/>
        <result property="questionType" column="question_type"/>
        <result property="difficult" column="difficult"/>
        <result property="subjectId" column="subject_id"/>
        <result property="stemText" column="stem_text"/>
        <result property="stemImg" column="stem_img_url"/>
        <result property="freeTag" column="free_tag"/>
        <result property="score" column="score_val"/>
        <result property="examYear" column="exam_year"/>
        <result property="examPaperId" column="exam_paper_id"/>
        <result property="examPaperName" column="exam_paper_name"/>
        <result property="status" column="status"/>
        <result property="createUser" column="create_user"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time_ms"/>
        <result property="updateTime" column="update_time_ms"/>
        <result property="updateBy" column="update_by"/>
        <!-- J 卡段② / page 端点专属，详情端点 SELECT 不带这列，serialize 时为 null -->
        <result property="isFavorite" column="is_favorite"/>
    </resultMap>

    <!--
      详情 ResultMap（extends QuestionItemMap 加详情字段）。
      PRD-B-006 收尾增量后：
        - stemText 优先用 biz_text_content S 外置, 兜底走 biz_question.stem_text(老数据)
        - answer  唯一来源 = biz_text_content A 外置(PRD-B-013 后短答案列已 DROP)
        - explain 唯一来源 = biz_text_content E 外置(老数据无解析文本)
      列别名 stem_text_resolved / answer_resolved / explain_resolved 由 SELECT 端的 COALESCE 拼好喂进来。
    -->
    <resultMap id="QuestionDetailMap" type="org.dromara.book.domain.vo.QuestionDetailVo"
               extends="QuestionItemMap">
        <result property="stemText" column="stem_text_resolved"/>
        <result property="answer" column="answer_resolved"/>
        <result property="answerImg" column="answer_img_url"/>
        <result property="explain" column="explain_resolved"/>
        <result property="explainImg" column="explain_img_url"/>
        <result property="fileBin" column="file_bin_url"/>
    </resultMap>

    <!--
      列表项基础列（page 用，不含详情字段）
      score 字段 DB 没单列存（真分值在 biz_paper_question.score），page 阶段固定 0
    -->
    <sql id="QuestionItemColumns">
        q.id,
        q.question_type,
        q.difficult,
        q.subject_id,
        q.stem_text,
        q.stem_img_url,
        q.free_tag,
        0 AS score_val,
        q.exam_year,
        q.exam_paper_id,
        q.exam_paper_name,
        q.status,
        q.create_user,
        q.create_by,
        UNIX_TIMESTAMP(q.create_time) * 1000 AS create_time_ms,
        UNIX_TIMESTAMP(q.update_time) * 1000 AS update_time_ms,
        q.update_by
    </sql>

    <!--
      分页查询 — 走 MyBatis-Plus 分页插件（@Param(Constants.WRAPPER) 注入 ${ew.customSqlSegment}）。

      ew 由 Service 端 QueryWrapper 构造（含 status='1' / subjectId 前缀 / questionType / difficult /
      keyWord LIKE / notUsedQuestion / notTaskQuestion / order by）。
    -->
    <select id="selectQuestionPage"
            resultMap="QuestionItemMap">
        SELECT
        <include refid="QuestionItemColumns"/>,
        (CASE WHEN f.id IS NOT NULL THEN 1 ELSE 0 END) AS is_favorite
        FROM biz_question q
        LEFT JOIN biz_question_favorite f
          ON f.question_id = q.id
         AND f.user_id = #{currentUserId}
        ${ew.customSqlSegment}
    </select>

    <!--
      PRD-A-005 T5 — 收藏分页（GET /teacher/qd/favorite/page）。
      INNER JOIN biz_question_favorite f 只出当前用户已收藏题；folderId 非空再按收藏夹过滤。
      复用 QuestionItemMap + QuestionItemColumns（与题库 page 同一套 misikt 字段命名 + VO），
      is_favorite 恒 1（既然是收藏列表）。按 f.create_time DESC（最近收藏在前），id 兜底稳定排序。
      软删题过滤 status<>'2'（与 listByIds 一致，避免列出已删题）。
      currentUserId 由 Service 注入（@SaCheckLogin 兜底，不容 null），防越权。
    -->
    <select id="selectFavoritePage" resultMap="QuestionItemMap">
        SELECT
        <include refid="QuestionItemColumns"/>,
        1 AS is_favorite
        FROM biz_question q
        INNER JOIN biz_question_favorite f
          ON f.question_id = q.id
         AND f.user_id = #{currentUserId}
        WHERE q.status &lt;&gt; '2'
        <if test="folderId != null">
            AND f.folder_id = #{folderId}
        </if>
        ORDER BY f.create_time DESC, q.id DESC
    </select>

    <!--
      单题详情 — 含详情字段（answer/explain/file 等，PRD-B-013 后死字段已 DROP）。
      不限 status（详情可看草稿/已发/软删；V0.1 实数据全 '1'）。
    -->
    <select id="selectQuestionDetailById"
            parameterType="java.lang.Long"
            resultMap="QuestionDetailMap">
        SELECT
            q.id,
            q.question_type,
            q.difficult,
            q.subject_id,
            <!-- PRD-B-006: 三要素外置优先, biz_text_content 命中走外置, 否则降级老 stem_text -->
            COALESCE(tc_s.content, q.stem_text)         AS stem_text_resolved,
            tc_a.content                                AS answer_resolved,
            tc_e.content                                AS explain_resolved,
            q.stem_text,
            q.stem_img_url,
            q.answer_img_url,
            q.explain_img_url,
            q.file_bin_url,
            q.free_tag,
            0 AS score_val,
            q.exam_year,
            q.exam_paper_id,
            q.exam_paper_name,
            q.status,
            q.create_user,
            q.create_by,
            UNIX_TIMESTAMP(q.create_time) * 1000 AS create_time_ms,
            UNIX_TIMESTAMP(q.update_time) * 1000 AS update_time_ms,
            q.update_by
        FROM biz_question q
        LEFT JOIN biz_text_content tc_s ON tc_s.question_id = q.id AND tc_s.content_type = 'S'
        LEFT JOIN biz_text_content tc_a ON tc_a.question_id = q.id AND tc_a.content_type = 'A'
        LEFT JOIN biz_text_content tc_e ON tc_e.question_id = q.id AND tc_e.content_type = 'E'
        WHERE q.id = #{id}
    </select>

    <!--
      Q' 卡段① — 批量按 id 拉详情（试卷预览 PDF 导出场景）。
      软删过滤：status&lt;&gt;'2'。
      不带 ORDER BY — Service 端按入参 ids 顺序用 LinkedHashMap 重排（FIND_IN_SET 跨方言风险，BE 不依赖）。
    -->
    <select id="selectQuestionDetailByIds"
            resultMap="QuestionDetailMap">
        SELECT
            q.id,
            q.question_type,
            q.difficult,
            q.subject_id,
            <!-- PRD-B-006: 同 selectQuestionDetailById 拼三要素外置, 试卷预览/PDF 导出也吃到 -->
            COALESCE(tc_s.content, q.stem_text)         AS stem_text_resolved,
            tc_a.content                                AS answer_resolved,
            tc_e.content                                AS explain_resolved,
            q.stem_text,
            q.stem_img_url,
            q.answer_img_url,
            q.explain_img_url,
            q.file_bin_url,
            q.free_tag,
            0 AS score_val,
            q.exam_year,
            q.exam_paper_id,
            q.exam_paper_name,
            q.status,
            q.create_user,
            q.create_by,
            UNIX_TIMESTAMP(q.create_time) * 1000 AS create_time_ms,
            UNIX_TIMESTAMP(q.update_time) * 1000 AS update_time_ms,
            q.update_by
        FROM biz_question q
        LEFT JOIN biz_text_content tc_s ON tc_s.question_id = q.id AND tc_s.content_type = 'S'
        LEFT JOIN biz_text_content tc_a ON tc_a.question_id = q.id AND tc_a.content_type = 'A'
        LEFT JOIN biz_text_content tc_e ON tc_e.question_id = q.id AND tc_e.content_type = 'E'
        WHERE q.id IN
        <foreach collection="ids" item="qid" open="(" separator="," close=")">
            #{qid}
        </foreach>
        AND q.status &lt;&gt; '2'
    </select>

</mapper>
