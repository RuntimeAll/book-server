<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.book.mapper.BizPaperMapper">
    <resultMap id="PaperDetailHeaderMap" type="org.dromara.book.domain.vo.PaperDetailVo">
        <id property="paperId" column="paper_id"/>
        <result property="paperName" column="paper_name"/>
        <result property="subjectId" column="subject_id"/>
        <result property="paperCategoryId" column="paper_category_id"/>
        <result property="score" column="score"/>
        <result property="suggestTime" column="suggest_time"/>
        <result property="questionCount" column="question_count"/>
        <result property="examYear" column="exam_year"/>
        <result property="paperType" column="paper_type"/>
        <result property="createBy" column="create_by"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <resultMap id="PaperSectionMap" type="org.dromara.book.domain.vo.PaperSectionVo">
        <id property="sectionId" column="id"/>
        <result property="title" column="title"/>
        <result property="sort" column="sort"/>
    </resultMap>

    <select id="selectPaperDetailHeader" resultMap="PaperDetailHeaderMap">
        <bind name="officialOwnerId" value="@org.dromara.book.service.paper.SelectionRules@OFFICIAL_OWNER_ID"/>
        SELECT p.id AS paper_id, p.name AS paper_name, p.subject_id, p.paper_category_id,
               p.score, p.suggest_time, p.question_count, p.exam_year, p.paper_type, p.create_by, p.remark
        FROM biz_paper p
        WHERE p.id = #{paperId}
          AND (
              (p.status = '1'
               AND (p.create_by = #{currentUserId}
                    OR (p.create_by = #{officialOwnerId} AND p.paper_kind &lt;&gt; '2')))
              OR (p.status = '0' AND p.create_by = #{currentUserId})
          )
    </select>

    <select id="selectSectionsByPaperId" resultMap="PaperSectionMap">
        SELECT id, title, sort FROM biz_paper_section
        WHERE paper_id = #{paperId} ORDER BY sort ASC, id ASC
    </select>

    <resultMap id="PaperListItemMap" type="org.dromara.book.domain.vo.PaperListItemVo">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="questionCount" column="question_count"/>
        <result property="score" column="score"/>
        <result property="suggestTime" column="suggest_time"/>
        <result property="createTime" column="create_time"/>
        <result property="createUser" column="create_user"/>
        <result property="subjectId" column="subject_id"/>
        <result property="paperCategoryId" column="paper_category_id"/>
        <result property="paperType" column="paper_type"/>
        <result property="paperKind" column="paper_kind"/>
        <result property="status" column="status"/>
        <result property="sort" column="sort"/>
    </resultMap>

    <select id="selectPaperListPage" resultMap="PaperListItemMap">
        SELECT p.id, p.name, p.question_count, p.score, p.suggest_time, p.create_time,
               CAST(p.create_by AS SIGNED) AS create_user, p.subject_id, p.paper_category_id,
               p.paper_type, p.paper_kind, CAST(p.status AS SIGNED) AS status, p.sort
        FROM biz_paper p
        ${ew.customSqlSegment}
    </select>
</mapper>
