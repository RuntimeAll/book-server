<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-book</artifactId>

    <description>
        ruoyi-book 题库 + 卷库业务模块（misikt 教师端复刻 V0.1 闭环）
    </description>

    <dependencies>

        <!-- 通用工具 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- Knife4j / Swagger API 文档 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>

        <!-- MyBatis-Plus + 分页 + PageHelper -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <!-- Redis / Redisson 缓存（题库目录树缓存 / basket 缓存场景）-->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-redis</artifactId>
        </dependency>

        <!-- 操作日志 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <!-- Sa-Token 鉴权 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <!-- Web 通用（统一异常处理 / 跨域 / R<T> 等）-->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <!-- Excel 导入导出（试卷导入 / 题库导出场景预留）-->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-excel</artifactId>
        </dependency>

        <!-- OSS 对象存储（举一反三母题图上传 OssFactory/OssClient）-->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-oss</artifactId>
        </dependency>

        <!-- 引用 ruoyi-system（查 sys_user 拿教师信息 / 鉴权信息）-->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-system</artifactId>
        </dependency>

        <!-- OpenPDF：PRD-A-014 试卷导出异步化，纯图模式拼 PDF + 中文水印（STSong-Light 内置 CJK 字体）。
             OpenPDF 1.3.x 起把 iText 亚洲字体合进主 jar，STSong-Light 开箱可用，无需额外 fonts-asian 依赖。-->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.43</version>
        </dependency>

        <!-- openhtmltopdf：PRD-C-213 BUG-010 备课材料渲染去浏览器化——纯 Java 进程内 HTML→PDF，
             家长版 PNG 走 HTML→PDF→pdfbox 光栅化（pdfbox 2.0.x 随本依赖传递引入）。
             ⚠️ 中文字体不打包进 jar：运行期探测系统字体（simhei.ttf / Noto CJK），yml schedule.pdf.font-* 可覆盖。-->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.0.10</version>
        </dependency>
        <!-- jsoup：把拼装 HTML（题干为 DB 富文本，非严格 XHTML）规整成 openhtmltopdf 要求的 W3C DOM -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>

        <!-- 单测（渲染样张自验 ScheduleRenderUtilTest，@Tag(dev)，默认 skipTests=true 需 -DskipTests=false 跑）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
